# Local SQLite for Prisma Client when Turso is not configured (path relative to apps/server).
DATABASE_URL="file:./prisma/dev.db"

# Turso (production / shared remote DB) — get token: turso db tokens create hivetalk
TURSO_DATABASE_URL="libsql://hivetalk-rizwansar.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="paste-turso-auth-token-here"

JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000

# Browser origin of the Next.js app (local or Vercel URL)
CLIENT_ORIGIN="http://localhost:3000"
NODE_ENV="development"
COOKIE_SECURE="false"
# Use none + COOKIE_SECURE=true when web (Vercel) and API are on different domains
COOKIE_SAME_SITE="lax"

# Web (apps/web/.env.local) — point these at your API host
# NEXT_PUBLIC_API_URL="http://localhost:4000"
# NEXT_PUBLIC_WS_URL="http://localhost:4000"

